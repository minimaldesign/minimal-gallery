{
  "name": "minimalgallery",
  "version": "0.0.0",
  "description": "The minimalgallery command line: add photos, sync, check, watch and publish a gallery.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "minimalgallery": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@minimalgallery/pipeline": "workspace:*",
    "chokidar": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
