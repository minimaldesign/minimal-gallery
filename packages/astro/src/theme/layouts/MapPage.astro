---
/**
 * The map page (`/map/`, for `src/pages/map.astro`): every photo with GPS
 * coordinates on a map of the world, as thumbnails that link to their
 * pages. The header is the panel header's breadcrumb (home / Map, the
 * count). The map itself is map.js, loaded only here; without script the
 * page says it needs it and links home. A gallery with no located photos,
 * or with `map: false` in its config, gets a message page instead, and no
 * link points here.
 */
import config from 'virtual:minimalgallery/config';
import { getMapPoints, withBase } from '../../gallery.ts';
import HomeLink from '../components/HomeLink.astro';
import '../styles/map.css';
import GalleryLayout from './GalleryLayout.astro';
import MessagePage from './MessagePage.astro';

const points = await getMapPoints();
const n = points.length;
---

{n === 0 || !config.map ? (
  <MessagePage title="No map">
    None of the photos has a location yet.&#32;
    <a href={withBase('/')}>See the photos</a>
  </MessagePage>
) : (
  <GalleryLayout
    title={`Map · ${config.title}`}
    description={`Where the photos in ${config.title} were taken.`}
    class="mapView"
    script={false}>
    <header class="mapView_head surface">
      <nav class="mapView_crumbs" aria-label="Context">
        <ol>
          <li>
            <HomeLink />
          </li>
          <li aria-current="page">Map</li>
        </ol>
        <span class="mapView_count">
          {n} photo{n === 1 ? '' : 's'}
        </span>
      </nav>
    </header>
    <main
      class="mapView_canvas"
      id="map"
      aria-label="Map of the photos"
      data-tiles={config.map.tiles}
      data-glyphs={config.map.glyphs}>
      <noscript>
        <p class="mapView_note">
          The map needs JavaScript.&#32;
          <a href={withBase('/')}>See the photos</a>
        </p>
      </noscript>
    </main>
    <script
      is:inline
      type="application/json"
      id="map-points"
      set:html={JSON.stringify(points).replace(/</g, '\\u003c')}
    />
    <script>
      import '../scripts/map.js';
    </script>
  </GalleryLayout>
)}
