---
/**
 * The info pane: the photo's record, every value a link to its context.
 * Opened by the Info checkbox (CSS, no script), remembered across photos;
 * only its Close label and `i` close it. The rows come from `infoOf()`,
 * which the context JSON carries too: a step inside the page fills the
 * pane with the same markup.
 */
import { infoOf, type Photo } from '../../gallery.ts';

interface Props {
  photo: Photo;
}
const { photo: p } = Astro.props;
---

<aside
  class="pane pane-info info surface"
  id="info"
  aria-labelledby="info-title">
  <div class="pane_head">
    <h2 class="pane_title" id="info-title">
      {p.title}
    </h2>
    <label class="pane_close" for="info-toggle">
      Close
    </label>
  </div>
  <div
    class="info_caption"
    hidden={!p.captionHtml}
    set:html={p.captionHtml ?? ''}
  />
  <dl class="info_list">
    {infoOf(p).map((row) => (
      <div class="info_row">
        <dt class="info_term">{row.term}</dt>
        <dd
          class:list={['info_value', { 'info_value-exposure': row.exposure }]}
          set:html={row.html}
        />
      </div>
    ))}
  </dl>
</aside>
