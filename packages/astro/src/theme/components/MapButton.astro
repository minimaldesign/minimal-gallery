---
/**
 * The Map icon button in the panel header: a link to the map page, shown
 * only when some photos have GPS coordinates (and the config has not
 * turned the map off). `m` follows it (the theme script).
 */
import { getMapPoints, withBase } from '../../gallery.ts';
import Icon from './Icon.astro';
import Tip from './Tip.astro';

const show = (await getMapPoints()).length > 0;
---

{show && (
  <div class="toggle toggle-plain">
    <a
      class="toggle_option"
      data-map-link
      href={withBase('/map/')}
      aria-label="Map">
      <Icon name="map" />
      <Tip label="<b>M</b>ap" shortcut="m" />
    </a>
  </div>
)}
