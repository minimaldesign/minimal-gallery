---
/**
 * The panel's map view: the context's photos with GPS coordinates on a
 * map, when the gallery has a map (PanelHead shows the Map option then).
 * Empty in the HTML: the theme script (mg.js) sends the photos and the
 * map area in an `mg-map` event, and the script below loads MapLibre and
 * map.js the first time the view is shown, so no other page pays for it.
 */
import config from 'virtual:minimalgallery/config';

const map = config.map;
---

{map && (
  <div
    class="mapView"
    role="region"
    aria-label="Map of these photos"
    data-tiles={map.tiles}
    data-glyphs={map.glyphs}>
    <p class="mapView_note" hidden>
      None of these photos has a location.
    </p>
  </div>
)}

{map && <script>
  // the map view (mg-map) and the info pane's map (mg-locate, see
  // InfoPane.astro) share map.js. mg.js keeps the latest request of each
  // in self.mgMapWant and self.mgLocateWant too, so one sent before this
  // module ran is not lost
  type Want = { mgMapWant?: unknown; mgLocateWant?: unknown };
  const load = () => import('../scripts/map.js');
  const show = (detail: unknown) => load().then((m) => m.show(detail));
  const locate = (detail: unknown) => load().then((m) => m.locate(detail));
  document.addEventListener('mg-map', (e) => show((e as CustomEvent).detail));
  document.addEventListener('mg-locate', (e) =>
    locate((e as CustomEvent).detail)
  );
  const early = self as Want;
  if (early.mgMapWant) show(early.mgMapWant);
  if (early.mgLocateWant) locate(early.mgLocateWant);
</script>}
