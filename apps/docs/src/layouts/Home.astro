---
/**
 * The document shell of the one-pager. Unlike the docs pages it does not
 * use Starlight: it is an mCSS page wearing the gallery’s theme (see
 * src/styles/home.css), with the same self-hosted Geist files.
 */
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/home.css';

interface Props {
  title: string;
  description: string;
  /** The photo a shared link shows, and what it shows in words */
  image: ImageMetadata;
  imageAlt: string;
}
const { title, description, image, imageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: image, format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0f0f0f" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content={String(share.attributes.width)} />
    <meta
      property="og:image:height"
      content={String(share.attributes.height)}
    />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--mg-font-text" preload />
    <Font cssVariable="--mg-font-mono" />
  </head>
  <body class="home">
    <slot />
  </body>
</html>
