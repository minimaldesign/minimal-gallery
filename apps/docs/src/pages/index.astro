---
/**
 * docs.minimalgallery.net: the one-pager. The gallery is the hero (a wall
 * of photos from minimalgallery.net as its grid shows them, under the same
 * translucent surfaces), then the promise, three pillars, the featured
 * parts of the gallery with the rest in a list, the admin, three steps and
 * the story behind the project, told in the first person.
 */
import { Image } from 'astro:assets';
import Home from '../layouts/Home.astro';
import KeysCard from '../components/home/KeysCard.astro';
import Mosaic from '../components/home/Mosaic.astro';
import Logo from '../assets/logo.svg';
import admin from '../assets/admin.jpg';
import filters from '../assets/filters.jpg';
import haleakala from '../../../../examples/demo/photos/colors/Haleakala.jpg';

const GALLERY = 'https://minimalgallery.net/';
const GITHUB = 'https://github.com/minimaldesign/minimal-gallery';
const STUDIO = 'https://minimaldesign.net/';

const pillars = [
  {
    title: 'Photos first',
    text: 'Each photo fills the screen on a dark background, and the controls fade away while you look. Visitors step through an album with the arrow keys, a click or a swipe, and every photo has its own link to share.',
  },
  {
    title: 'Organized for you',
    text: 'Drop in folders of photos and each one becomes an album. The camera, lens, aperture, shutter speed and date in every file are sorted for you, so visitors can browse everything shot at f/1.4 or in one year.',
  },
  {
    title: 'Publish with one click',
    text: 'Edit everything in the built-in admin on your computer, then publish with one click. It’s a plain website, so free hosting or almost any web host will do. The gallery is a folder on your computer, and it stays yours.',
  },
];

const features = [
  ['Slideshow', 'Press Space to play or pause any filtered set of photos.'],
  [
    'Random photo',
    'Press R for a surprise, never the same photo twice until you’ve seen them all.',
  ],
  [
    'Filmstrip',
    'A strip of thumbnails under the photo, to jump anywhere in the album.',
  ],
  [
    'Grid or list',
    'Thumbnails in three sizes, cropped square or whole, or a list you can sort by any column.',
  ],
  ['Zoom to 1:1', 'See every pixel of a high-resolution photo.'],
  [
    'Photo details',
    'Camera, lens, exposure, date, place and your caption, one key away.',
  ],
  [
    'Fill or fit',
    'Fill the window edge to edge, or see the whole photo in its original aspect ratio.',
  ],
  ['Timeline', 'Jump through the years from the rail beside the grid.'],
  [
    'Made for phones too',
    'Swipe between photos, and panels open as sheets at the bottom of the screen.',
  ],
];

const steps = [
  {
    title: 'Create your gallery',
    text: 'Set up a gallery folder on your computer. The admin opens in your browser, with a checklist for the first steps.',
  },
  {
    title: 'Organize your photos',
    text: 'Drag in photos or whole folders. Folders become albums and the details in each file are sorted for you. Add titles and captions, and preview the gallery as you go.',
  },
  {
    title: 'Publish online',
    text: 'Press Publish, and the gallery goes online on free hosting or the web host of your choice. Add more photos whenever you like and publish again.',
  },
];
---

<Home
  title="minimal gallery: your photos in a beautiful modern gallery, for free"
  description="minimal gallery shows your photos online in a clean, modern gallery that puts the photos first. Up to about 3,000 high-resolution photos on free hosting, with no subscription.">
  <header class="siteBar surface">
    <a class="siteBar_home" href="/">
      <Logo class="siteBar_logo" aria-hidden="true" />
      minimal gallery
    </a>
    <nav class="siteBar_nav" aria-label="Site">
      <a class="siteBar_link" href="/getting-started/">
        Docs
      </a>
      <a class="siteBar_link" href={GITHUB}>
        GitHub
      </a>
    </nav>
  </header>

  <main>
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro_panel surface">
        <h1 class="intro_title" id="intro-title">
          All your photos, in a beautiful modern gallery. For free.
        </h1>
        <p class="intro_lede">
          minimal gallery shows your work in a clean, modern interface where
          nothing competes with the photos: they fill the screen, the controls
          hide while you look, and the next photo appears instantly. Put up to
          about 3,000 high-resolution photos online and host them for free. No
          subscription, ever.
        </p>
        <p class="intro_actions">
          <a class="bt bt-primary" href="/getting-started/">
            Get started
          </a>
          <a class="bt bt-outline" href={GALLERY}>
            See it in action
          </a>
        </p>
      </div>
      <Mosaic class="intro_mosaic" />
    </section>

    <section class="pillars wrap" aria-label="What it does">
      <div>
        <ul class="pillars_list">
          {pillars.map((pillar) => (
            <li class="pillars_item">
              <h2 class="pillars_title">{pillar.title}</h2>
              <p class="pillars_text">{pillar.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="feature wrap" aria-labelledby="keys-title">
      <div class="feature_inner">
        <div class="feature_body">
          <h2 class="feature_title" id="keys-title">
            Full keyboard support
          </h2>
          <p class="feature_text">
            Every part of the gallery is one key away. The arrow keys step
            through the photos, Space starts a slideshow, I shows a photo’s
            details and slash opens the filters. Press the question mark at any
            time to see them all.
          </p>
        </div>
        <div class="feature_media">
          <Image
            class="feature_photo"
            src={haleakala}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 42rem, 100vw"
            format="avif"
            quality={55}
            loading="lazy"
            decoding="async"
          />
          <KeysCard class="feature_overlay" />
        </div>
      </div>
    </section>

    <section
      class="feature feature-reverse wrap"
      aria-labelledby="filters-title">
      <div class="feature_inner">
        <div class="feature_body">
          <h2 class="feature_title" id="filters-title">
            Filter by anything in your photos
          </h2>
          <p class="feature_text">
            Press slash and every album, year, month, place, camera, lens and
            f-number in the gallery is there, with the number of photos for
            each. Type a few letters to narrow the list, then pick one to see
            just those photos.
          </p>
        </div>
        <div class="feature_media">
          <Image
            class="feature_shot"
            src={filters}
            alt="The filter panel open over a photo of cherry blossoms above a pond: a search field, then buttons for every album, year, month, place and camera in the gallery, each with its number of photos."
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1024px) 42rem, 100vw"
            format="avif"
            quality={65}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="features wrap" aria-labelledby="features-title">
      <div>
        <h2 class="features_title" id="features-title">
          And there’s more
        </h2>
        <ul class="features_list">
          {features.map(([name, text]) => (
            <li class="features_item">
              <b>{name}</b>
              {text}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="feature wrap" aria-labelledby="admin-title">
      <div class="feature_inner">
        <div class="feature_body">
          <h2 class="feature_title" id="admin-title">
            Everything in one place
          </h2>
          <p class="feature_text">
            The admin opens in your browser and works on your own computer.
            Select a photo to edit its title, caption and date, or move it
            within its album. Add photos and albums, change the settings and
            publish, all from the same window.
          </p>
        </div>
        <div class="feature_media">
          <Image
            class="feature_shot"
            src={admin}
            alt="The minimal gallery admin: albums in a sidebar, a grid of photos, and a photo of Takayama selected, with its title, caption and date taken ready to edit in a panel on the right."
            widths={[640, 960, 1280, 1920]}
            sizes="(min-width: 1024px) 42rem, 100vw"
            format="avif"
            quality={65}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="recipe wrap" aria-labelledby="recipe-title">
      <div>
        <h2 class="recipe_title" id="recipe-title">
          Three steps
        </h2>
        <ol class="recipe_list">
          {steps.map((step) => (
            <li class="recipe_step">
              <h3 class="recipe_stepTitle">{step.title}</h3>
              <p class="recipe_text">{step.text}</p>
            </li>
          ))}
        </ol>
        <p class="recipe_actions">
          <a class="bt bt-primary" href="/getting-started/">
            Get started
          </a>
        </p>
      </div>
    </section>

    <section class="closing wrap" aria-labelledby="closing-title">
      <div>
        <h2 class="closing_title" id="closing-title">
          Why I built minimal gallery
        </h2>
        <p class="closing_text">
          I built the first minimal gallery about 20 years ago, to host my own
          photo blog. Since then, the way we share photos has changed. Everyone
          posts to Instagram, where a photo is a small image in a feed, between
          ads, scrolled past in seconds.
        </p>
        <p class="closing_text">
          I wanted something different: a place where the photos come first, at
          full size, with nothing competing for attention. A gallery I own, that
          costs nothing to host, and that anyone can use and improve. So I
          rebuilt minimal gallery from scratch for today’s web: fast, modern,
          open source and free.
        </p>
        <p class="closing_text">
          minimalgallery.net is my own gallery, and the photos at the top of
          this page come from it. Open a photo, step through with the arrow
          keys, or browse by camera, year or place.
        </p>
        <p class="closing_actions">
          <a class="bt bt-primary" href={GALLERY}>
            Visit minimalgallery.net
          </a>
          <a class="bt bt-outline" href="/getting-started/">
            Get started
          </a>
        </p>
      </div>
    </section>
  </main>

  <footer class="siteFooter wrap">
    <div class="siteFooter_inner">
      <p class="siteFooter_name">minimal gallery</p>
      <nav class="siteFooter_nav" aria-label="More">
        <a href="/getting-started/">Docs</a>
        <a href="/versions/">Version history</a>
        <a href="/downloads/">Downloads</a>
        <a href={GITHUB}>Source on GitHub</a>
      </nav>
      <p class="siteFooter_credit">
        <a href={STUDIO}>A minimal design</a>
      </p>
    </div>
  </footer>
</Home>
