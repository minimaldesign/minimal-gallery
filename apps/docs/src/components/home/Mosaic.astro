---
/**
 * The hero: a wall of square thumbnails from minimalgallery.net, as the
 * gallery’s own grid shows them. The photos are read from
 * examples/demo/photos, so the docs follow the gallery; one that is no longer
 * there is left out. Each links to its page on minimalgallery.net. The wall
 * is decorative for assistive technology and the keyboard (the intro’s
 * “See it in action” link is the way in), so its links are out of the tab order.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

// The photos, chosen by Yann. The glob names them one by one so that only
// these are bundled.
const files = import.meta.glob<ImageMetadata>(
  '../../../../../examples/demo/photos/{feelings/Montauk,feelings/Mushroom,people/Last_day_in_Kyoto,people/Arashiyama Smile,feelings/The_Path,colors/Takayama,feelings/Shirakawa-Go,feelings/A Quiet Evening,light/Prayers,people/On_Christmas,colors/sunk,feelings/Cycles,feelings/Jonathan,light/Reflection,shapes/Coney_Island_Tower,light/Loin_des_yeux_mais_pas_le_reste,people/Saxophonist,colors/Painter,feelings/Disparate,feelings/Ahead,people/Dancing_in_the_rain,light/The_coming,people/Baby_Surfer,colors/Haleakala,colors/Puff_Ball,shapes/Chocolate_DNA,feelings/Waking_up_02,light/Kyoto_Station,colors/Sakura_Impression,colors/Ohara_Garden,motion/Hanami_fire,light/Kyoto_Sunset,people/Gion_crowd,light/Hanamikoji,people/Kyoto_Kids,shapes/wired,people/sararimen,colors/Bleeding_Metal,people/Konnichiwa,light/Kyoto_Night,people/Kyoto_Bikers,colors/blue_door,feelings/Chain,shapes/amarre,people/Naima,light/snow,feelings/Cold,people/Apple_in_Paris,feelings/Itchy,colors/Upstate_NY}.jpg',
  { import: 'default' }
);

// The gallery’s URL for a photo: the album folder, then the file name in
// lowercase with every run of other characters replaced by “_” (the
// pipeline’s slug rule).
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '_');

// The glob lists them by album; a fixed shuffle mixes the albums so the
// wall does not read as one album after another.
const shuffleKey = (path: string) =>
  [...path].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 1000003, 7);

const photos = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => shuffleKey(a) - shuffleKey(b))
    .map(async ([path, load]) => {
      const [album, name] = path.split('/').slice(-2);
      return {
        image: await load(),
        href: `https://minimalgallery.net/${album}/${slug(name.replace(/\.jpg$/, ''))}/`,
      };
    })
);

// Large screens hold more squares than there are photos: the wall repeats
// from the start rather than leaving a gap.
const wall = [...photos, ...photos.slice(0, 20)];
---

<ul class:list={['mosaic', className]} aria-hidden="true">
  {wall.map((photo, i) => (
    <li class="mosaic_item">
      <a class="mosaic_link" href={photo.href} tabindex="-1">
        <Image
          class="mosaic_image"
          src={photo.image}
          alt=""
          width={480}
          height={480}
          fit="cover"
          widths={[240, 360, 480]}
          sizes="(min-width: 1858px) 260px, (min-width: 858px) 14vw, 120px"
          format="avif"
          quality={55}
          loading={i < 16 ? 'eager' : 'lazy'}
          decoding="async"
        />
      </a>
    </li>
  ))}
</ul>
