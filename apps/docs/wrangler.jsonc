// Cloudflare config for docs.minimalgallery.net: a Worker that serves the
// built site as static assets, like the demo gallery. `pnpm docs:publish`
// builds it and uploads dist from this computer. The custom domain below
// makes wrangler create the DNS record and the certificate on first deploy.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minimalgallery-docs",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "docs.minimalgallery.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
