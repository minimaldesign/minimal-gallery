// Cloudflare config for docs.minimalgallery.net: a Worker that serves the
// built site as static assets. Unlike minimalgallery.net, which publishes the
// way a user's gallery does, Workers Builds builds it from master. The custom
// domain below makes the first deploy create its DNS record and certificate.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minimalgallery-docs",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "docs.minimalgallery.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Cloudflare builds other branches than master with `wrangler preview`,
  // which needs this block; it can stay empty.
  "previews": {},
}
