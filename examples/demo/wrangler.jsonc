// Cloudflare config for the demo gallery: a Worker that serves static assets.
// `pnpm demo:publish` uploads dist from this computer, as a user's gallery does.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minimalgallery-demo",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "minimalgallery.net", "custom_domain": true },
    { "pattern": "www.minimalgallery.net", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
